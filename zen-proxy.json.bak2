{
  "host": "127.0.0.1",
  "port": 8787,
  "upstream": "https://opencode.ai/inference/openai/v1",
  "ua": "opencode/latest/2.1.4/cli",
  "clientName": "cli",
  "projectHash": "",
  "tracing": true,
  "autoUA": true,
  "uaRefreshMs": 21600000,
  "injectSession": true,
  "overrideSession": true,
  "probeAuth": "auto",
  "defaultModel": "deepseek-v4.1-flash-free",
  "modelAliases": {},
  "agentPreamble": "",
  "agentTools": true,
  "responsesModels": [
    "gpt-5*",
    "gpt-6*",
    "grok-*",
    "muse-spark-*"
  ],
  "maxBodyBytes": 33554432,
  "retriesPerModel": 2,
  "retryBackoffMs": 500,
  "rateLimitMax": 0,
  "rateLimitWindowMs": 60000,
  "proxyKey": "",
  "defaultZenKey": "",
  "trustForwarded": false,
  "timeoutMs": 120000,
  "cacheMs": 30000,
  "autoSync": false,
  "autoSyncIntervalMs": 3600000,
  "torEnabled": false,
  "torLanes": 10,
  "torRaceWidth": 5,
  "torSticky": false,
  "torRotateIdentity": false,
  "torCountries": "us,de,nl,fr,ro,gb,ca,se,pl,ch",
  "torFallbackCountries": "",
  "torPreferredCountries": "",
  "torSweepS": 20,
  "torSweepMoves": 3,
  "torExitSoftCap": 100,
  "torExitHoldS": 600,
  "torRounds": 2,
  "torRetryMs": 120000,
  "torStreamGraceS": 120,
  "torBinary": "",
  "torDownload": true,
  "torDataDir": "",
  "torProof": true,
  "torStrictNodes": true,
  "torMaxCircuitDirtiness": 600
}